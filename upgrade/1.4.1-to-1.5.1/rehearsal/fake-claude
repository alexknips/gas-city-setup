# tmux and just idle, so the city's lifecycle (start, adopt, stop) can be watched without spending tokens.
case " $* " in *" --version "*) echo "2.1.288 (Claude Code)"; exit 0 ;; esac
echo "fake-claude (rehearsal stub) pid $$ args: $*"
exec sleep infinity
