# gcs config: the ONE file you may want to edit. Setup copies this to ~/.config/gcs/config.env on
# the first run and reads that copy on every run. After an edit, apply it with:  gcs setup
# Plain shell syntax (KEY=value, no spaces around "="); "$HOME" is expanded. Defaults are shown.

# --- host ---------------------------------------------------------------------------------
GCS_USER=gc                     # linux user made when setup starts as root (first run; read from the env: GCS_USER=name)
GC_CITY_DIR="$HOME/gc"          # where the city lives (config, agents, beads)
GCS_REPOS_DIR="$HOME/projects"  # where `gcs rig-add <url>` clones repos
SWAP=auto                       # auto = add a 4 GB swap file when RAM < 16 GB | off | <size in GB>
TAILSCALE=no                    # yes = install tailscale too (login step is printed at the end)
GIT_NAME="Gas City"             # commit author for agents; only used when git has no identity yet
GIT_EMAIL="gascity@localhost"   # ... set your own here so PRs show your account

# --- agents -------------------------------------------------------------------------------
MODEL_MAYOR=opus                # opus | sonnet | haiku : the mayor (coordinator)
MODEL_DEFAULT=opus              # ... deacon, witness, refinery and every other patrol role
MODEL_POLECAT=sonnet            # ... the polecats (the workers that write code)
POLECAT_POOL=1                  # parallel polecats per rig; each one costs tokens and CPU
MERGE_MODE=pr                   # pr = agents open a GitHub PR and stop | direct = refinery merges to main itself

# --- dashboard  (dashboard/install.sh) ------------------------------------------------------
DASH_BIND=                      # empty = the Tailscale IP when up, else 127.0.0.1
DASH_PORT=8787

# --- review bot (review-bot/install.sh) -----------------------------------------------------
REVIEW_BOT=off                  # on | off

# --- backup (backup/install.sh) -------------------------------------------------------------
BACKUP_DEST=                    # empty = local archive only
